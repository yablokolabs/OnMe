# Cloudflare named tunnel for OnMe — keeps https://onme.yablokolabs.com pointed
# at the loopback-only OnMe backend and comes back automatically after a reboot.
#
# Install:
#   cp deploy/cloudflared-config.yml ~/.cloudflared/onme-config.yml
#   sudo cp deploy/onme-cloudflared.service /etc/systemd/system/cloudflared-onme.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now cloudflared-onme
#   journalctl -u cloudflared-onme -f
#
# The unit name is `cloudflared-onme` rather than `cloudflared`, because a second
# unit called `cloudflared` would collide with the one already serving
# psst.yablokolabs.com on this VM.
#
# The config lives in a user-writable directory, so this unit deliberately runs
# unprivileged: a tunnel that only dials 127.0.0.1 needs no root.

[Unit]
Description=Cloudflare Tunnel for onme.yablokolabs.com
Documentation=file:/home/azureuser/OnMe/deploy/cloudflared-config.yml
After=network-online.target onme-backend.service
# Ordering only: cloudflared reconnects to the edge on its own, so the tunnel
# starting before the backend is survivable, just noisy in the journal.
Wants=network-online.target

[Service]
# Type=simple on purpose: cloudflared runs in the foreground and Restart=always
# covers a dropped edge connection. Type=notify would require sd_notify support,
# and a unit that never sends READY=1 hangs for 90s and is killed at start.
Type=simple
User=azureuser
Group=azureuser
# --config is explicit and NOT the default ~/.cloudflared/config.yml: that file
# belongs to the other project's tunnel on this VM, and `tunnel run` with no
# argument would run whichever tunnel it names.
ExecStart=/home/azureuser/.local/bin/cloudflared --no-autoupdate --config /home/azureuser/.cloudflared/onme-config.yml tunnel run

Restart=always

[Install]
WantedBy=multi-user.target
