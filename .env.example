# OnMe environment variables.
#
# This single file at the repository root is shared by the Expo app and the
# backend in ./server (which loads it automatically in development), so a secret
# never needs to be duplicated. Copy to .env and fill in real values.
# .env is git-ignored — never commit it.

# ------------------------------------------------------------------ mobile app
# Public base URL of the OnMe backend. Not a secret.
# Leave it empty and the app still works: the try-on flow explains that it has
# nowhere to send the photos instead of failing with a network error. Must be
# https:// for a release build — OnMe refuses to upload a photo of a person over
# an insecure connection.
# EXPO_PUBLIC_ONME_BACKEND_URL=https://your-onme-backend.example.com

# Optional shared access token, only needed when the backend sets
# ONME_CLIENT_TOKEN. Public by construction — it ships in the app bundle — so it
# is a throttle, not authentication. Real authorization is a public-release gate.
# EXPO_PUBLIC_ONME_BACKEND_TOKEN=

# RevenueCat public SDK key for the store this build sells through: the Android
# app's "goog_…" key from the project, or a "test_…" key from one of its Test
# Stores (which is the only way to complete a purchase without a store listing).
# Public by construction — it can read offerings and start a purchase, and it
# cannot read a customer list. Leave it empty and the app has no store at all:
# the ten free try-ons are then the whole product, which is a working app rather
# than a broken one. The AdMob ids live in app.json and src/services/ads.ts, not
# here, because they are compiled into the native build.
# EXPO_PUBLIC_REVENUECAT_KEY=

# ------------------------------------------------------------- server-side only
# The variables below are read ONLY by ./server. They are never bundled into the
# app, never logged, never returned from an endpoint and never sent to the
# client. Do NOT create an EXPO_PUBLIC_ variant of any of them.

# fal.ai runs the try-on model. This box has no GPU, so the generation is always
# a rented one. Without this key /health reports tryOnReady: false and the app
# says plainly that it cannot make a picture yet — nothing here ever fakes a
# result.
# SERVER-SIDE SECRET. NEVER rename to EXPO_PUBLIC_FAL_KEY.
FAL_KEY=server_only_secret

# Where a bare visit to the backend's own hostname is sent. The hostname serves
# the API, which is not where the app is, so somebody who opens it in a browser
# is answered with a 302 to this page instead of {"error":"not_found"}.
# Not a secret. The default is https://onme-dl.yablokolabs.com/ — make it yours
# when you deploy elsewhere, or set it empty to have the root answer not_found
# the way a pure API would.
# ONME_DOWNLOAD_URL=https://your-download-page.example.com/
