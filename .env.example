# OnMe environment variables.
#
# This single file at the repository root is shared by the Expo app and the
# backend in ./server (which loads it automatically in development), so a secret
# never needs to be duplicated. Copy to .env and fill in real values.
# .env is git-ignored — never commit it.

# ------------------------------------------------------------------ mobile app
# Public base URL of the OnMe backend. Not a secret.
# Leave it empty and the app still works: the try-on flow explains that it has
# nowhere to send the photos instead of failing with a network error. Must be
# https:// for a release build — OnMe refuses to upload a photo of a person over
# an insecure connection.
# EXPO_PUBLIC_ONME_BACKEND_URL=https://your-onme-backend.example.com

# Optional shared access token, only needed when the backend sets
# ONME_CLIENT_TOKEN. Public by construction — it ships in the app bundle — so it
# is a throttle, not authentication. Real authorization is a public-release gate.
# EXPO_PUBLIC_ONME_BACKEND_TOKEN=

# ------------------------------------------------------------- server-side only
# The variable below is read ONLY by ./server. It is never bundled into the app,
# never logged, never returned from an endpoint and never sent to the client.
# Do NOT create an EXPO_PUBLIC_ variant of it.

# fal.ai runs the try-on model. This box has no GPU, so the generation is always
# a rented one. Without this key /health reports tryOnReady: false and the app
# says plainly that it cannot make a picture yet — nothing here ever fakes a
# result.
# SERVER-SIDE SECRET. NEVER rename to EXPO_PUBLIC_FAL_KEY.
FAL_KEY=server_only_secret
